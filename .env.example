# ────────────────────────────────────────────────────────────────────
# Quibly Landing — local environment variables
# ────────────────────────────────────────────────────────────────────
# Setup:
#   1. cp .env.example .env.local
#   2. Fill in real values from Resend Dashboard + Upstash Console
#   3. npm run dev
#
# `lib/env.ts` parses these at module load and crashes with a Zod error
# listing every missing key — there is no NODE_ENV leniency. This is
# intentional (D-08, D-10): the failure mode "works on my machine,
# breaks in preview" is exactly what we are preventing.
#
# .env.local is gitignored. .env.example (this file) ships only
# placeholder values — gitleaks in .husky/pre-commit blocks any real
# `re_*` or Upstash key from being committed.
# ────────────────────────────────────────────────────────────────────

# Resend transactional + audience client (Phase 4)
# Source: Resend Dashboard -> API Keys -> scope "Sending access"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Production audience for the live waitlist (Phase 4)
# Source: Resend Dashboard -> Audiences -> "Quibly Waitlist" -> Audience ID
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Preview/PR audience — separate from production (Phase 4)
# Source: Resend Dashboard -> Audiences -> "Quibly Waitlist (Preview)" -> Audience ID
RESEND_AUDIENCE_PREVIEW_ID=00000000-0000-0000-0000-000000000000

# Webhook signature secret for bounce + complaint events (Phase 4)
# Source: Resend Dashboard -> Webhooks -> signing secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Upstash Redis REST URL for sliding-window rate limit (Phase 4)
# Source: Upstash Console -> Redis DB -> REST API -> URL
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io

# Upstash Redis REST API token (Phase 4)
# Source: Upstash Console -> Redis DB -> REST API -> Token
UPSTASH_REDIS_REST_TOKEN=AYxAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RESEND_FROM_POSTAL_ADDRESS — physical postal address for welcome-email footer (Phase 4 — CAN-SPAM EMAIL-05 / D-10)
# HARD blocker for production deploy. Placeholder is acceptable in dev/preview only.
# Founder must source registered agent / USPS PO Box / CMRA before production merge.
# Do NOT use a personal home address.
RESEND_FROM_POSTAL_ADDRESS=YOUR-POSTAL-ADDRESS-HERE

# Public site URL for unsubscribe link construction in welcome email (Phase 4)
# Public env var (NEXT_PUBLIC_*) — exposed to the client; not in lib/env.ts schema.
# IMPORTANT (pre-Phase-6 reality): the apex `useQuibly.com` is NOT yet bound to Vercel
# (Phase 6 DEPLOY-01..02 unshipped). Until apex binding ships, set the production
# value to the Vercel-aliased URL `https://quibly-landing.vercel.app` so welcome-email
# unsubscribe links resolve to the live Next.js handler. Flip back to
# `https://usequibly.com` after Phase 6 ships.
# Production (current):  https://quibly-landing.vercel.app
# Production (post-Phase-6):  https://usequibly.com
# Preview / dev:  the Vercel preview URL or http://localhost:3000
# If unset, the action falls back through VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL
# → 'https://usequibly.com' (Plan 04-08 defensive chain). Setting this explicitly
# is still preferred so behavior is deterministic across environments.
NEXT_PUBLIC_SITE_URL=https://quibly-landing.vercel.app
